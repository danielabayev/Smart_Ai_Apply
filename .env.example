# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored - never commit real secrets.

# Google AI Studio API key used by agents/profiler_agent to call Gemini.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Optional overrides (defaults shown in agents/profiler_agent/config.py) ---
# PROFILER_AGENT_PORT=8001
# PROFILER_AGENT_MODEL=gemini-3.6-flash
PROFILER_AGENT_CHECKPOINT_DB=profiler_agent_state.sqlite3

# --- Optional overrides (defaults shown in apps/api/src/api/config.py) ---
# DATABASE_URL=postgresql+psycopg://smart_ai_apply:smart_ai_apply@localhost:5432/smart_ai_apply
# DEFAULT_USER_EMAIL=user@example.com
# PROFILER_AGENT_URL=http://localhost:8001
# PROFILER_AGENT_TIMEOUT_SECONDS=120
